      "post": {
        "operationId": "render_page",
        "responses": {
          "200": {
            "content": {
              "image/png": {}
            },
            "description": "Rendered PNG image binary"
          },
          "400": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Render failure"
          }
        },
        "summary": "Render a single PDF page directly to a PNG image stream",
        "tags": [
          "PDF Operations"
        ]
      }
    },
    "/api/v1/pdf/split": {
      "post": {
        "operationId": "split",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SplitJsonRequest"
              }
            }
          },
          "description": "JSON configuration or multipart form",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Split successfully"
          }
        },
        "summary": "Split a PDF document into separate pages or ranges",
        "tags": [
          "PDF Operations"
        ]
      }
    },
    "/api/v1/pdf/tools/{tool_name}": {
      "post": {
        "operationId": "handle_tool",
        "parameters": [
          {
            "description": "Name of the tool (with or without 'pdf_' prefix)",
            "in": "path",
            "name": "tool_name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "Tool executed successfully"
          },
          "400": {
            "description": "Invalid multipart or payload"
          },
          "500": {
            "description": "Execution error"
          }
        },
        "summary": "Execute any MCP tool by URL path param (/api/v1/pdf/tools/{tool_name}) via multipart or JSON",
        "tags": [
          "MCP"
        ]
      }
    },
    "/api/v1/pdf/watermark": {
      "post": {
        "operationId": "watermark",
        "requestBody": {
