              }
            },
            "description": "Service is healthy and ready"
          }
        },
        "summary": "Gateway health check",
        "tags": [
          "Health"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Gateway health check and tool status",
      "name": "Health"
