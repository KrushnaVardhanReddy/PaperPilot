{
  "components": {
    "schemas": {
      "ApiResponse": {
        "description": "Standard API response envelope (Responses section shows expected schema contract).",
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {},
          "success": {
            "example": true,
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      },
      "CompareJsonRequest": {
        "properties": {
          "file1": {
            "example": "doc_v1.pdf",
            "type": "string"
          },
          "file2": {
            "example": "doc_v2.pdf",
            "type": "string"
          }
        },
        "required": [
          "file1",
          "file2"
        ],
        "type": "object"
      },
      "CompressJsonRequest": {
        "properties": {
          "input": {
            "example": "input.pdf",
            "type": "string"
          },
          "output": {
            "example": "output.pdf",
            "type": "string"
          },
          "quality": {
            "example": "medium",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "input",
          "output"
        ],
        "type": "object"
      },
      "ConvertJsonRequest": {
        "properties": {
          "format": {
            "example": "docx",
            "type": [
              "string",
              "null"
            ]
          },
          "input": {
            "example": "input.pdf",
            "type": "string"
          },
          "output": {
            "example": "output.docx",
            "type": "string"
          }
        },
        "required": [
          "input",
          "output"
        ],
        "type": "object"
      },
      "ExcelToCsvRequest": {
        "properties": {
          "input": {
            "example": "data.xlsx",
            "type": "string"
          },
          "output": {
            "example": "data.csv",
            "type": "string"
          },
          "sheet": {
            "example": "Sheet1",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "input",
          "output"
        ],
        "type": "object"
      },
      "ExcelToJsonRequest": {
        "properties": {
          "has_headers": {
            "example": true,
            "type": [
              "boolean",
              "null"
            ]
          },
          "input": {
            "example": "data.xlsx",
            "type": "string"
          },
          "sheet": {
            "example": "Sheet1",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "input"
        ],
        "type": "object"
      },
      "ExtractTextJsonRequest": {
        "properties": {
          "input": {
            "example": "input.pdf",
            "type": "string"
          },
          "page": {
            "example": "1",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "input"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "example": "ok",
            "type": "string"
          },
          "tools_count": {
            "example": 44,
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "example": "0.1.0",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "tools_count"
        ],
        "type": "object"
      },
      "InfoJsonRequest": {
        "properties": {
          "input": {
            "example": "input.pdf",
            "type": "string"
          }
        },
        "required": [
          "input"
        ],
        "type": "object"
      },
      "McpExecRequest": {
        "properties": {
          "arguments": {},
          "tool": {
            "example": "pdf_metadata",
            "type": "string"
          }
        },
        "required": [
          "tool"
        ],
        "type": "object"
      },
      "MergeJsonRequest": {
        "properties": {
          "inputs": {
            "example": [
              "doc1.pdf",
              "doc2.pdf"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "output": {
            "example": "merged.pdf",
            "type": "string"
          }
        },
        "required": [
          "inputs",
          "output"
        ],
        "type": "object"
      },
      "OfficeConvertJsonRequest": {
        "properties": {
          "input": {
            "example": "tests/e2e_fixtures/real/test.xlsx",
            "type": "string"
          },
          "output": {
            "example": "tests/e2e_fixtures/out/penta_e2e/doc.md",
            "type": "string"
          }
        },
        "required": [
          "input",
          "output"
        ],
        "type": "object"
      },
      "RagChunksJsonRequest": {
        "properties": {
          "input": {
            "example": "tests/e2e_fixtures/real/single_page.pdf",
            "type": "string"
          },
          "max_chunk_size": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "overlap": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "input"
        ],
        "type": "object"
      },
      "SplitJsonRequest": {
        "properties": {
          "input": {
            "example": "input.pdf",
            "type": "string"
          },
          "output": {
            "example": "output_dir/",
            "type": [
              "string",
              "null"
            ]
          },
          "pages": {
            "example": "1-3,5",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "input"
        ],
        "type": "object"
      },
      "WatermarkJsonRequest": {
        "properties": {
          "angle": {
            "example": 45.0,
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "color": {
            "example": "gray",
            "type": [
              "string",
              "null"
            ]
          },
          "font_size": {
            "example": 54.0,
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "input": {
            "example": "input.pdf",
            "type": "string"
          },
          "opacity": {
            "example": 0.2,
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "output": {
            "example": "watermarked.pdf",
            "type": "string"
          },
          "text": {
            "example": "CONFIDENTIAL",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "input",
          "output"
        ],
        "type": "object"
      }
    }
  },
  "info": {
