+        results.push(TestExecutionResult {
+            tool_id: tool.into(),
+            interface: InterfaceType::Mcp,
+            tier,
+            data_sent: "MCP JSON-RPC".into(),
+            assertion_checked: "Valid JSON-RPC response".into(),
