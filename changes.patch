+            )
+            .await?;
+
+        let passed = if tier == ComplexityTier::Negative { !success } else { success };
+
+        results.push(TestExecutionResult {
+            tool_id: tool.into(),
+            interface: InterfaceType::Api,
+            tier,
+            data_sent: "POST /api/v1/pdf/sanitize".into(),
+            assertion_checked: "HTTP 200".into(),
+            expected_result: if tier == ComplexityTier::Negative { "Error".into() } else { "Success".into() },
+            actual_result: if passed { "API call processed".into() } else { format!("API error: {:?}", resp) },
+            passed,
+            latency_ms: latency,
+        });
+    }
+
+    // 4. WASM Target Parity (Browser in-memory)
+    for tier in [ComplexityTier::Simple, ComplexityTier::Negative] {
+        results.push(TestExecutionResult {
+            tool_id: tool.into(),
