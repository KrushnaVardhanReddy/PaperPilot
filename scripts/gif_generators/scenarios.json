{
  "demo_01_ask_natural_language": {
    "steps": [
      { "type": "type", "text": "paperpilot ask \"rotate 90 degrees and extract pages 1 to 3\" invoice.pdf -o processed.pdf -y" },
      { "type": "delay", "ms": 400 },
      { "type": "output", "text": "<span style=\"color:#94a3b8;\">NLP offline intent resolved...</span>" },
      { "type": "delay", "ms": 300 },
      { "type": "output", "text": "<span style=\"color:#94a3b8;\">Executed in 24ms...</span>" },
      { "type": "delay", "ms": 200 },
      { "type": "output", "text": "<span style=\"color:#4ade80;\">Operation completed successfully.</span>" },
      { "type": "delay", "ms": 2000 }
    ]
  },
  "demo_02_pii_security_scan": {
    "steps": [
      { "type": "type", "text": "paperpilot pii-scan --input medical_record.pdf" },
      { "type": "delay", "ms": 400 },
      { "type": "output", "text": "<span style=\"color:#38bdf8; background:#0284c744; padding:2px 4px; border-radius:4px;\">[Zero-Trace: Memory Only]</span> Scanning medical_record.pdf..." },
      { "type": "delay", "ms": 800 },
      { "type": "output", "text": "<span style=\"color:#cbd5e1;\">{<br>&nbsp;&nbsp;\"total_findings\": 2,<br>&nbsp;&nbsp;\"findings_by_category\": { <span style=\"color:#f43f5e;\">\"SSN\"</span>: 1, <span style=\"color:#f43f5e;\">\"EMAIL\"</span>: 1 },<br>&nbsp;&nbsp;\"execution_time_ms\": 28.5<br>}</span>" },
      { "type": "delay", "ms": 2000 }
    ]
  },
  "demo_03_high_throughput_merge": {
    "steps": [
      { "type": "type", "text": "paperpilot merge --input quarterly_q1.pdf quarterly_q2.pdf quarterly_q3.pdf --output full_year.pdf" },
      { "type": "delay", "ms": 400 },
      { "type": "output", "text": "<span style=\"color:#94a3b8;\">Concatenating 3 documents (142 pages)...</span>" },
      { "type": "delay", "ms": 200 },
      { "type": "output", "text": "<span style=\"color:#94a3b8;\">Bookmarks preserved.</span>" },
      { "type": "output", "text": "<span style=\"color:#4ade80;\">Output written: 3.4 MB in 18ms.</span>" },
      { "type": "delay", "ms": 2000 }
    ]
  },
  "demo_04_rest_api_gateway": {
    "steps": [
      { "type": "type", "text": "paperpilot serve --port 7823 &" },
      { "type": "delay", "ms": 400 },
      { "type": "output", "text": "<span style=\"color:#4ade80;\">Listening on http://127.0.0.1:7823</span>" },
      { "type": "delay", "ms": 800 },
      { "type": "type", "text": "curl -X POST http://127.0.0.1:7823/api/v1/pdf/rotate -H 'Content-Type: application/json' -d '{\"input\":\"doc.pdf\",\"angle\":90,\"output\":\"out.pdf\"}'" },
      { "type": "delay", "ms": 400 },
      { "type": "output", "text": "<span style=\"color:#cbd5e1;\">{\"status\":\"<span style=\"color:#4ade80;\">success</span>\",\"duration_ms\":14,\"pages_rotated\":12}</span>" },
      { "type": "delay", "ms": 2000 }
    ]
  },
  "demo_05_mcp_agent_workflow": {
    "steps": [
      { "type": "output", "text": "<span style=\"color:#d946ef;\">[AI Assistant]</span> Calling MCP server tool 'pdf_rotate'..." },
      { "type": "delay", "ms": 600 },
      { "type": "output", "text": "<span style=\"color:#38bdf8;\">&gt;&gt; REQUEST</span><br><span style=\"color:#94a3b8;\">{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"pdf_rotate\",\"arguments\":{\"input\":\"scan.pdf\",\"angle\":90}}}</span>" },
      { "type": "delay", "ms": 800 },
      { "type": "output", "text": "<span style=\"color:#4ade80;\">&lt;&lt; RESPONSE</span><br><span style=\"color:#94a3b8;\">{\"jsonrpc\":\"2.0\",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"Successfully rotated scan.pdf by 90 degrees.\"}]}}</span>" },
      { "type": "delay", "ms": 2000 }
    ]
  },
  "demo_06_pipeline_conditional_workflow": {
    "steps": [
      { "type": "type", "text": "paperpilot run examples/workflows/conditional-invoice.ppflow invoice.pdf -o processed.pdf" },
      { "type": "delay", "ms": 400 },
      { "type": "output", "text": "[1/3] ocr-if-needed (condition: if_scanned = true) ... <span style=\"color:#facc15;\">SKIPPED</span> (native digital PDF)" },
      { "type": "delay", "ms": 300 },
      { "type": "output", "text": "[2/3] compress-large (condition: if_page_count_gt = 50) ... <span style=\"color:#38bdf8;\">EXECUTING</span> (level: aggressive)" },
      { "type": "delay", "ms": 400 },
      { "type": "output", "text": "[3/3] label (watermark: \"PROCESSED\") ... <span style=\"color:#4ade80;\">APPLIED</span> (opacity: 0.3)" },
      { "type": "delay", "ms": 200 },
      { "type": "output", "text": "Pipeline completed in 32ms. <span style=\"color:#4ade80;\">Output saved: processed.pdf</span>" },
      { "type": "delay", "ms": 2000 }
    ]
  }
}
