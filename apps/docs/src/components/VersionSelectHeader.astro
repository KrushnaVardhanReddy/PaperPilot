---
import type { Props } from '@astrojs/starlight/props';
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
---

<div class="header-wrapper">
  <DefaultHeader {...Astro.props}><slot /></DefaultHeader>
  <div class="version-badge-container">
    <label for="doc-version-select" class="sr-only">Documentation Version</label>
    <div class="version-select-wrapper">
      <span class="version-dot"></span>
      <select id="doc-version-select" aria-label="Documentation Version">
        <option value="v0.8.1" selected>v0.8.1 (Current Release)</option>
        <option value="v0.8.0">v0.8.0</option>
        <option value="v0.7.0">v0.7.0</option>
        <option value="v0.6.0">v0.6.0</option>
        <option value="v0.5.0">v0.5.0</option>
        <option value="latest">v0.8.1-dev (latest)</option>
      </select>
    </div>
  </div>
</div>

<style>
  .header-wrapper {
    display: contents;
  }
  .version-badge-container {
    position: absolute;
    top: 14px;
    right: 170px;
    z-index: 50;
    display: flex;
    align-items: center;
  }
  .version-select-wrapper {
    display: inline-flex;
    align-items: center;
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 9999px;
    padding: 2px 10px 2px 8px;
    font-size: 0.75rem;
    color: #e2e8f0;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }
  .version-select-wrapper:hover {
    border-color: rgba(56, 189, 248, 0.6);
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.2);
  }
  .version-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
    margin-right: 6px;
    box-shadow: 0 0 6px #10b981;
  }
  .version-select-wrapper select {
    background: transparent;
    color: inherit;
    border: none;
    font-weight: 600;
    font-size: 0.75rem;
    cursor: pointer;
    outline: none;
    padding-right: 2px;
  }
  .version-select-wrapper select option {
    background: #0f172a;
    color: #f1f5f9;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 768px) {
    .version-badge-container {
      position: static;
      margin-left: auto;
      margin-right: 8px;
    }
  }
</style>
