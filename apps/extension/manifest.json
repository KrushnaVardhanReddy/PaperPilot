{
  "manifest_version": 3,
  "name": "PaperPilot: Universal Document & AI Companion",
  "version": "1.0.0",
  "description": "Universal Document & AI Companion with WASM-first local processing and PaperPilot Desktop Gateway bridge.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:7823/*",
    "http://localhost:7823/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PaperPilot Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "*.wasm"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
