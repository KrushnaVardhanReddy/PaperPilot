{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm exec tsx ../../scripts/sync_roadmap.ts",
    "dev": "vite",
    "prebuild": "pnpm exec tsx ../../scripts/sync_roadmap.ts",
    "build": "vite build",
    "sync-roadmap": "pnpm exec tsx ../../scripts/sync_roadmap.ts",
    "test-roadmap": "pnpm exec tsx --test ../../scripts/sync_roadmap.test.ts",
    "test-roadmap-ui": "playwright test --config playwright.roadmap.config.ts",
    "check-roadmap": "tsc -p tsconfig.roadmap.json",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "rollup": "^4.64.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "dependencies": {
    "@swc/core": "^1.16.13",
    "paperpilot-wasm": "file:../../paperpilot-wasm/pkg"
  }
}
