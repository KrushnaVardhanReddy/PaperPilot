from typing import TypedDict

__version__: str

class RagChunk(TypedDict, total=False):
    index: int
    text: str
    token_count: int
    page_start: int
    page_end: int
    headings: list[str]

class PdfInfo(TypedDict):
    page_count: int
    version: str

class ToolInfo(TypedDict):
    id: str
    name: str
    description: str
    category: str

def list_tools() -> list[ToolInfo]: ...
def run_tool(tool_id: str, params_json: str = "{}") -> str: ...
def merge(pdfs: list[bytes]) -> bytes: ...
def split(pdf: bytes, ranges: str) -> list[bytes]: ...
def compress(pdf: bytes, level: str = "medium") -> bytes: ...
def to_markdown(pdf: bytes) -> str: ...
def extract_text(pdf: bytes, pages: list[int] | None = None) -> str: ...
def chunk_rag(pdf: bytes, max_tokens: int = 512, overlap: int = 50) -> list[RagChunk]: ...
def redact(pdf: bytes, terms: list[str], overlay_text: str | None = None) -> bytes: ...
def encrypt(pdf: bytes, user_password: str, owner_password: str | None = None) -> bytes: ...
def info(pdf: bytes) -> PdfInfo: ...
def repair(pdf: bytes) -> bytes: ...
def rotate(pdf: bytes, degrees: int, pages: list[int] | None = None) -> bytes: ...
def watermark(
    pdf: bytes,
    text: str,
    angle: float = 45.0,
    opacity: float = 0.2,
    font_size: float | None = None,
    color: str | None = None,
    pages: list[int] | None = None,
) -> bytes: ...

def merge_bytes(pdfs: list[bytes]) -> bytes: ...
def compress_bytes(pdf: bytes, level: str = "medium") -> bytes: ...
def to_markdown_bytes(pdf: bytes) -> str: ...
def extract_text_bytes(pdf: bytes, pages: list[int] | None = None) -> str: ...
def chunk_rag_bytes(pdf: bytes, max_tokens: int = 512, overlap: int = 50) -> list[RagChunk]: ...
def info_bytes(pdf: bytes) -> PdfInfo: ...
def rotate_bytes(pdf: bytes, degrees: int, pages: list[int] | None = None) -> bytes: ...
def watermark_bytes(
    pdf: bytes,
    text: str,
    angle: float = 45.0,
    opacity: float = 0.2,
    font_size: float | None = None,
    color: str | None = None,
    pages: list[int] | None = None,
) -> bytes: ...
