from typing import TypedDict

__version__: str

class RagChunk(TypedDict, total=False):
    index: int
    text: str
    token_count: int
    page_start: int
    page_end: int
    headings: list[str]

class PdfInfo(TypedDict):
    page_count: int
    version: str

def merge(pdfs: list[bytes]) -> bytes: ...
def split(pdf: bytes, ranges: str) -> list[bytes]: ...
def compress(pdf: bytes, level: str = "medium") -> bytes: ...
def to_markdown(pdf: bytes) -> str: ...
def extract_text(pdf: bytes, pages: list[int] | None = None) -> str: ...
def chunk_rag(pdf: bytes, max_tokens: int = 512, overlap: int = 50) -> list[RagChunk]: ...
def redact(pdf: bytes, terms: list[str], overlay_text: str | None = None) -> bytes: ...
def encrypt(pdf: bytes, user_password: str, owner_password: str | None = None) -> bytes: ...
def info(pdf: bytes) -> PdfInfo: ...
def repair(pdf: bytes) -> bytes: ...
